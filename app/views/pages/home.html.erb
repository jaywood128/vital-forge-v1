<div class="landing-page">
  <div class="hero">
    <h1>Welcome to VitalForge</h1>
    <p class="tagline">Track your fitness journey, one workout at a time</p>

    <div class="cta-buttons">
      <%= link_to "Sign Up", signup_path, class: "btn btn-primary" %>
      <%= link_to "Log In", login_path, class: "btn btn-secondary" %>
    </div>
  </div>

  <div class="features">
    <div class="feature">
      <h3>Track Workouts</h3>
      <p>Log your exercises and monitor your progress over time</p>
    </div>

    <div class="feature">
      <h3>Set Goals</h3>
      <p>Define your fitness objectives and stay motivated</p>
    </div>

    <div class="feature">
      <h3>Analyze Progress</h3>
      <p>View detailed insights and analytics on your fitness journey</p>
    </div>
  </div>
</div>

