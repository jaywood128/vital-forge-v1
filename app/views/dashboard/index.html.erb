<div class="dashboard">
  <header class="dashboard-header">
    <h1>Welcome back, <%= @user.first_name %>!</h1>
    <nav>
      <%= link_to "Profile", "#", class: "btn btn-secondary" %>
      <%= button_to "Logout", logout_path, method: :delete, class: "btn btn-outline" %>
    </nav>
  </header>

  <div class="dashboard-content">
    <div class="stats-card">
      <h2>Your Fitness Dashboard</h2>
      <p>This is where we'll mount React components to track your workouts!</p>
      
      <div class="user-info">
        <p><strong>Name:</strong> <%= @user.full_name %></p>
        <p><strong>Email:</strong> <%= @user.email %></p>
        <p><strong>Member since:</strong> <%= @user.created_at.strftime("%B %Y") %></p>
        <p><strong>Last login:</strong> <%= @user.last_login_at&.strftime("%B %d, %Y at %I:%M %p") || "First time!" %></p>
      </div>
    </div>

    <div class="quick-actions">
      <h3>Quick Actions</h3>
      <div class="action-buttons">
        <%= link_to "Log Workout", "#", class: "btn btn-primary" %>
        <%= link_to "View History", "#", class: "btn btn-secondary" %>
        <%= link_to "View Progress", "#", class: "btn btn-secondary" %>
      </div>
    </div>

    <!-- This is where React components will be mounted later -->
    <div id="workout-tracker-mount-point">
      <!-- React workout tracker component will go here -->
    </div>
  </div>
</div>

