<div class="auth-container">
  <div class="auth-card">
    <h1>Log In</h1>

    <%= form_with url: login_path, method: :post, local: true do |f| %>
      <% if flash[:alert] %>
        <div class="alert alert-error">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :email, "Email Address" %>
        <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :password, "Password" %>
        <%= f.password_field :password, required: true, autocomplete: "current-password", class: "form-control" %>
      </div>

      <div class="form-actions">
        <%= f.submit "Log In", class: "btn btn-primary" %>
      </div>
    <% end %>

    <div class="auth-footer">
      <p>Don't have an account? <%= link_to "Sign up", signup_path %></p>
    </div>
  </div>
</div>

