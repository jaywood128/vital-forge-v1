<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0a0e1a; margin: 0; padding: 0; }
      .wrapper { max-width: 480px; margin: 0 auto; padding: 40px 24px; }
      .logo { color: #ffffff; font-size: 22px; font-weight: 800; letter-spacing: -0.5px; margin-bottom: 32px; }
      .card { background: #111827; border-radius: 12px; padding: 32px; }
      h1 { color: #ffffff; font-size: 24px; font-weight: 700; margin: 0 0 12px; }
      p { color: rgba(255,255,255,0.65); font-size: 15px; line-height: 1.6; margin: 0 0 24px; }
      .btn { display: block; background: #F5A623; color: #ffffff; text-decoration: none; text-align: center; font-weight: 700; font-size: 16px; padding: 14px 24px; border-radius: 10px; }
      .link-fallback { margin-top: 20px; color: rgba(255,255,255,0.4); font-size: 13px; line-height: 1.5; word-break: break-all; }
      .link-fallback a { color: rgba(255,255,255,0.5); }
      .footer { margin-top: 32px; color: rgba(255,255,255,0.3); font-size: 12px; text-align: center; line-height: 1.6; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="logo">VitalForge</div>
      <div class="card">
        <h1>Reset your password</h1>
        <p>We received a request to reset the password for your VitalForge account. Tap the button below to choose a new password.</p>
        <a href="<%= @reset_url %>" class="btn">Reset Password</a>
        <div class="link-fallback">
          <p>If the button doesn't work, copy and paste this link into your browser:</p>
          <a href="<%= @reset_url %>"><%= @reset_url %></a>
        </div>
      </div>
      <div class="footer">
        This link expires in 2 hours. If you didn't request a password reset, you can safely ignore this email.<br><br>
        VitalForge &middot; [MAILING ADDRESS] &middot; [CITY, STATE ZIP]
      </div>
    </div>
  </body>
</html>
