<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .header {
      background: linear-gradient(135deg, #2563EB 0%, #1E40AF 100%);
      color: white;
      padding: 30px;
      border-radius: 8px;
      text-align: center;
      margin-bottom: 30px;
    }
    .stat-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin: 30px 0;
    }
    .stat-card {
      background: #F1F5F9;
      padding: 20px;
      border-radius: 8px;
      text-align: center;
    }
    .stat-value {
      font-size: 36px;
      font-weight: bold;
      color: #2563EB;
      margin: 10px 0;
    }
    .stat-label {
      color: #64748B;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .highlight {
      background: #DBEAFE;
      padding: 20px;
      border-left: 4px solid #2563EB;
      border-radius: 4px;
      margin: 20px 0;
    }
    .cta-button {
      display: inline-block;
      background: #F97316;
      color: white;
      padding: 15px 30px;
      text-decoration: none;
      border-radius: 8px;
      margin: 20px 0;
      font-weight: bold;
    }
    .footer {
      text-align: center;
      color: #64748B;
      font-size: 12px;
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid #E2E8F0;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>💪 Your Weekly Progress</h1>
    <p>Great work, <%= @user.first_name %>!</p>
  </div>

  <p>Here's a summary of your fitness journey this week:</p>

  <div class="stat-grid">
    <div class="stat-card">
      <div class="stat-label">Workouts</div>
      <div class="stat-value"><%= @stats[:total_workouts] %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Total Sets</div>
      <div class="stat-value"><%= @stats[:total_sets] %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Total Volume</div>
      <div class="stat-value"><%= number_with_delimiter(@stats[:total_volume]) %> lbs</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Active Minutes</div>
      <div class="stat-value"><%= @stats[:total_duration] %></div>
    </div>
  </div>

  <% if @stats[:streak] > 0 %>
    <div class="highlight">
      <strong>🔥 You're on fire!</strong><br>
      You've worked out <strong><%= @stats[:streak] %></strong> days in a row this week. Keep it up!
    </div>
  <% end %>

  <% if @stats[:most_common_exercise] %>
    <p><strong>💡 Your go-to exercise:</strong> <%= @stats[:most_common_exercise] %></p>
  <% end %>

  <div style="text-align: center;">
    <a href="http://localhost:3000/dashboard" class="cta-button">View Full Dashboard</a>
  </div>

  <div class="footer">
    <p>You're receiving this weekly summary from VitalForge</p>
    <p>Keep forging your vital self! 💪</p>
  </div>
</body>
</html>

