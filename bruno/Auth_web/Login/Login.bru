meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: inherit
}

headers {
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "user": {
      "email": "{{email}}",
      "password": "{{password}}"
    }
  }
}

vars:pre-request {
  email: jaywood128@gmail.com
  password: password123
}

settings {
  encodeUrl: true
  timeout: 0
}
