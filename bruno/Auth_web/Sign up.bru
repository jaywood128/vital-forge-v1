meta {
  name: Sign up
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/signup
  body: json
  auth: inherit
}

headers {
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "user": {
      "email": "jaywood128@gmail.com",
      "password": "{{password}}",
      "password_confirmation": "{{password}}",
      "first_name": "Johnathon",
      "last_name": "Wood"
    }
  }
}

vars:pre-request {
  password: password123!!
}

settings {
  encodeUrl: true
  timeout: 0
}
