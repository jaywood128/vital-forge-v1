meta {
  name: Edit Set
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/exercise_sets/:id
  body: json
  auth: inherit
}

params:path {
  id: 1
}

headers {
  X-CSRF-Token: {{csrfToken}}
  _vital_forge_session: {{_vital_forge_session}}
}

body:json {
  {
    "exercise_set": {
      "reps": 12,
      "weight": 135,
      "weight_unit": "lbs"
    }
  }
}

vars:pre-request {
  id: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
