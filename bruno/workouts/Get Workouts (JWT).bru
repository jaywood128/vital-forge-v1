meta {
  name: Get Workouts (JWT)
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/workouts
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

headers {
  Content-Type: application/json
}

docs {
  # Get Workouts (JWT Authentication)
  
  Tests the workouts endpoint with JWT token authentication (mobile).
  
  ## Setup:
  1. Login via mobile endpoint to get JWT token
  2. Set the token in environment variable: jwt_token
  3. Run this request
  
  ## Expected Response:
  ```json
  {
    "data": [
      {
        "id": 1,
        "performed_at": "2024-11-23T10:00:00Z",
        "duration_minutes": 45,
        "notes": "Great workout!",
        "created_at": "...",
        "updated_at": "..."
      }
    ]
  }
  ```
}

