# PostgreSQL Database Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit your actual .env file to git!

# Database credentials for local development
# DATABASE_HOST defaults to 'localhost' which works with Docker (port forwarding)
# Rails running natively connects to Docker PostgreSQL via localhost:5432
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_postgres_password_here

# OpenAI API Key
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# AI Features Toggle
# Set to "true" to enable OpenAI-powered weekly feedback (costs money!)
# Leave as "false" for production until you're ready to enable
ENABLE_AI_FEATURES=false

# Honeybadger Error Monitoring
# Get your API key from: https://app.honeybadger.io/
HONEYBADGER_API_KEY=hbp_your_honeybadger_api_key_here
HONEYBADGER_ENV=development

# Staging Database URL (optional - only needed for staging deployments)
# Format: postgresql://username:password@host:port/database
STAGING_DATABASE_URL=postgresql://user:pass@host:5432/database
